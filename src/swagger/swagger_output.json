  "paths": {
    "/api/categorias": {
      "get": {
        "tags": [
          "Categorías"
        ],
        "summary": "Listar categorías",
        "description": "Devuelve todas las categorías o filtra por coincidencia de nombre.",
        "parameters": [
          {
            "name": "nombre",
            "in": "query",
            "required": false,
            "type": "string",
            "description": "Filtro opcional por nombre."
          }
        ],
        "responses": {
          "200": {
            "description": "Lista de categorías",
            "schema": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "id_categoria": {
                    "type": "integer",
                    "format": "int32"
                  },
                  "nombre": {
                    "type": "string",
                    "example": "Novela"
                  }
                }
              }
            }
          },
          "400": {
            "description": "Filtro nombre inválido"
          },
          "500": {
            "description": "Error interno"
          }
        }
      },
      "post": {
        "tags": [
          "Categorías"
        ],
        "summary": "Crear categoría",
        "parameters": [
          {
            "name": "body",
            "in": "body",
            "required": true,
            "schema": {
              "type": "object",
              "required": [
                "nombre"
              ],
              "properties": {
                "nombre": {
                  "type": "string",
                  "example": "Novela"
                }
              }
            }
          }
        ],
        "responses": {
          "201": {
            "description": "Categoría creada",
            "schema": {
              "type": "object",
              "properties": {
                "id_categoria": {
                  "type": "integer",
                  "format": "int32"
                },
                "nombre": {
                  "type": "string",
                  "example": "Novela"
                }
              }
            }
          },
          "400": {
            "description": "Datos inválidos"
          },
          "500": {
            "description": "Error interno"
          }
        }
      }
    },
